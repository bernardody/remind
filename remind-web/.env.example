# ── API (backend Spring Boot) ───────────────────────────────────────────────
# Pública (usada no browser). Em produção: https://api.remindapp.com.br
NEXT_PUBLIC_API_URL=http://localhost:8080
# Server-side (BFF / Route Handlers). Normalmente igual à de cima.
API_URL=http://localhost:8080

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Autenticação (Auth.js) ──────────────────────────────────────────────────
# Gerar com: npx auth secret
AUTH_SECRET=

# Login com Google (psicólogo, docs/specs/001-login-google-psicologo). MESMO
# OAuth Client ID já usado no backend (api: GOOGLE_CLIENT_ID) — é o valor
# público de audiência do ID token, não um segredo (o Client Secret não é
# usado aqui, o fluxo é só Google Identity Services no browser). Sem essa env
# var, o botão "Continuar com o Google" não aparece (degrade gracioso).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Destino do lead (formulário "Solicitar Demonstração") ───────────────────
# Escolha UM destino. Se nenhum estiver configurado, /api/leads degrada
# graciosamente (HTTP 202) sem quebrar a landing.
#
# Opção A — Notion (cria uma página numa database "Leads")
NOTION_TOKEN=
NOTION_LEADS_DB_ID=
#
# Opção B — Google Sheets (append via Apps Script Web App / webhook)
SHEETS_WEBHOOK_URL=
